# EmailJS — https://www.emailjs.com/
# This file is committed; .env is gitignored (your real keys stay private).
#
# 1. Copy this file:  cp .env.example .env
# 2. Paste your Service ID, Template ID, and Public Key from EmailJS dashboard.
# 3. Template must use: {{user_name}}, {{user_email}}, {{message}}
# 4. Restart dev server after changes: npm run dev
#
# Deploy (pick one):
#   A) Build on your PC (with .env present), then upload dist/ — keys are baked into the build.
#   B) On Vercel/Netlify: Project Settings → Environment Variables → same three VITE_* names → redeploy.
#
# If keys are missing at build time, the form still works via mailto fallback.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
